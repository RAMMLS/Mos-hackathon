+               for f in ftrs if f['properties'].get('restriction_type')=='oks']
+    infrastructure=[transform(FWD.transform,shape(f['geometry'])) for f in ftrs
+                    if f['properties']['object_type'] in ('heat_network','heat_chamber')]
+    cases=[];targets=[]
