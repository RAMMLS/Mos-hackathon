 <node id="12873467352" visible="true" version="2" changeset="166940599" timestamp="2025-05-29T19:52:46Z" user="literan" uid="830106" lat="55.7411126" lon="37.5911016">
  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="В частной мужской гимназии Льва Поливанова ученики не носили форму, не пользовались тетрадями в казённых переплётах и многие предметы изучали по специально написанным для гимназии учебникам."/>
  <tag k="memorial" v="plaque"/>
 </node>
 <node id="12873467353" visible="true" version="1" changeset="166930332" timestamp="2025-05-29T15:57:41Z" user="BodhidharmaI" uid="10255266" lat="55.7411587" lon="37.5910032">
  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="Students of Lev Polivanov's private boys school never wore uniforms nor used notebooks with state covers. Many courses were taught by textbooks which were designed specifically for the school."/>
  <tag k="memorial" v="plaque"/>
 </node>
