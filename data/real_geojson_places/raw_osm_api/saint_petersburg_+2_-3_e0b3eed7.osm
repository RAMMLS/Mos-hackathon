 <node id="12040698582" visible="true" version="2" changeset="154158550" timestamp="2024-07-19T20:38:52Z" user="Soshal Distan Singh" uid="11327915" lat="59.9507078" lon="30.2917809">
  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="Владимир Петрович Кондрашин выдающийся тренер, чемпион мира и Олимпийских игр. В этом дворце его баскетбольный клуб &quot;Спартак&quot; стал чемпионом СССР в 1975 г. и СНГ в 1992 г."/>
  <tag k="memorial" v="plaque"/>
  <tag k="name" v="В.П. Кондрашину"/>
  <tag k="subject:wikidata" v="Q733104"/>
  <tag k="subject:wikipedia" v="ru:Кондрашин, Владимир Петрович"/>
 </node>
