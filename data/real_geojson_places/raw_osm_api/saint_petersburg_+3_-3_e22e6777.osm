 <node id="10737731573" visible="true" version="12" changeset="141361632" timestamp="2023-09-16T23:16:38Z" user="traveleditor" uid="8726248" lat="59.9575213" lon="30.2898786">
  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="Котлинский Владимир Карпович, подпоручик. Выпускник военно-топографического училища 1914 года. Возглавил контратаку &quot;мертвецов&quot; 06.08.1915 г. Крепость Осовец."/>
