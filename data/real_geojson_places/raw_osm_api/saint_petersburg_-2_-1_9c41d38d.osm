 <node id="6517079216" visible="true" version="12" changeset="141361632" timestamp="2023-09-16T23:16:38Z" user="traveleditor" uid="8726248" lat="59.9175589" lon="30.3183175">
  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="Здесь с 1889 г. по 1894 г. учился и начал свою революционную работу в марксистском кружке студентов-технологов старейший деятель революционного движения, крупный учёный-энергетик Глеб Максимилианович Кржижановский"/>
  <tag k="memorial" v="plaque"/>
  <tag k="memorial:subject" v="Глеб Максимилианович Кржижановский"/>
  <tag k="name" v="Г. М. Кржижановскому"/>
  <tag k="subject:wikidata" v="Q944478"/>
  <tag k="subject:wikipedia" v="ru:Кржижановский, Глеб Максимилианович"/>
 </node>
 <node id="6517079217" visible="true" version="12" changeset="141361632" timestamp="2023-09-16T23:16:38Z" user="traveleditor" uid="8726248" lat="59.9178138" lon="30.3182608">
  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="Здесь с 1893 по 1930 год работал выдающийся российский учёный, основоположник электронного телевидения Борис Львович Розинг (1869–1933)"/>
  <tag k="memorial" v="plaque"/>
  <tag k="memorial:subject" v="Борис Львович Розинг"/>
  <tag k="name" v="Б. Л. Розингу"/>
  <tag k="subject:wikidata" v="Q276286"/>
  <tag k="subject:wikipedia" v="ru:Розинг, Борис Львович"/>
 </node>
 <node id="6517079218" visible="true" version="13" changeset="141361632" timestamp="2023-09-16T23:16:38Z" user="traveleditor" uid="8726248" lat="59.9173529" lon="30.3191358">
  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="В 1905–1906 гг. В.И. Ленин неоднократно выступал в здании Технологического института на партийных собраниях Петербургской социал-демократической организации по вопросам тактики большевиков в буржуазно-демократической революции"/>
  <tag k="inscription_1" v="и принимал участие в заседании Петербургского совета рабочих депутатов"/>
  <tag k="memorial" v="plaque"/>
  <tag k="memorial:subject" v="Владимир Ильич Ленин"/>
  <tag k="name" v="В. И. Ленину"/>
  <tag k="subject:wikidata" v="Q1394"/>
  <tag k="subject:wikipedia" v="ru:Ленин, Владимир Ильич"/>
 </node>
 <node id="6517079219" visible="true" version="12" changeset="141361632" timestamp="2023-09-16T23:16:38Z" user="traveleditor" uid="8726248" lat="59.9173818" lon="30.3193984">
  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="Здесь, в Технологическом институте, в 1910–1917 гг. учился Николай Петрович Горбунов, советский государственный деятель, один из организаторов науки, академик"/>
  <tag k="memorial" v="plaque"/>
  <tag k="memorial:subject" v="Николай Петрович Горбунов"/>
  <tag k="name" v="Н. П. Горбунову"/>
  <tag k="subject:wikidata" v="Q4811867"/>
  <tag k="subject:wikipedia" v="ru:Горбунов, Николай Петрович"/>
 </node>
 <node id="6517079220" visible="true" version="12" changeset="141361632" timestamp="2023-09-16T23:16:38Z" user="traveleditor" uid="8726248" lat="59.9174344" lon="30.3195440">
  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="Здесь, в Петербургском технологическом институте, в 1874–1875 годах учился Людвик Варыньский — деятель социалистического движения, основатель польской партии «Пролетариат» (1882). Погиб в Шлиссельбургской крепости в 1889 году."/>
  <tag k="memorial" v="plaque"/>
  <tag k="memorial:subject" v="Людвиг-Фаддей Северинович Варынский"/>
  <tag k="name" v="Л. Варыньскому"/>
  <tag k="subject:wikidata" v="Q1875503"/>
  <tag k="subject:wikipedia" v="ru:Варынский, Людвиг-Фаддей Северинович"/>
 </node>
