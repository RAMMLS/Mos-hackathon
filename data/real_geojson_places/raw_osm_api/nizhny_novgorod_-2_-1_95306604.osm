  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="В этом здании работал с 1957 по 1985 год Рубинчик Ефим Эммануилович, видный партийный и хозяйственный деятель СССР, Герой Социалистического Труда, лауреат Сталинской премии СССР, генерал-майор инженерно-танковой службы"/>
  <tag k="memorial" v="plaque"/>
  <tag k="memorial:subject" v="Ефим Эммануилович Рубинчик"/>
  <tag k="name" v="Е. Э. Рубинчику"/>
 </node>
 <node id="6483757774" visible="true" version="1" changeset="70408588" timestamp="2019-05-19T12:10:50Z" user="user_6446486" uid="6446486" lat="56.3125134" lon="43.9910782">
  <tag k="historic" v="memorial"/>
  <tag k="inscription:1" v="На этом месте стояла церковь во имя святого апостола и евангелиста Иоанна Богослова при городском детском приюте имени графини О. В. Кутайсовой."/>
  <tag k="inscription:2" v="Построена в 1903 году по проекту архитектора Д. А. Вернера на средства почётного гражданина М. А. Зайцева. Освящена при сослужении святого праведного Иоанна Кронштадтского"/>
  <tag k="memorial" v="plaque"/>
  <tag k="name" v="Церковь Иоанна Богослова"/>
 </node>
